{
  "name": "oh-my-dsh-agent-button",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent Agent button for the oh-my-dsh multi-agent suite: a dedicated frontend control that lists the omo agent roster and switches the session's agent seat.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  }
}
